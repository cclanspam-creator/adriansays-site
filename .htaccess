# Pieces that moved to acerpacer.com
Redirect 301 /future-of-education/ https://acerpacer.com/insights/future-of-education/
Redirect 301 /female-leaders-unleashed/ https://acerpacer.com/insights/female-leaders-unleashed/
Redirect 301 /feedback/ https://acerpacer.com/insights/feedback/
Redirect 301 /sandboxing-in-bhutan/ https://acerpacer.com/insights/sandboxing-in-bhutan/
Redirect 301 /alumni/ https://acerpacer.com/insights/alumni/
Redirect 301 /change-community-of-sandboxes/ https://acerpacer.com/insights/change-community-of-sandboxes/
Redirect 301 /interpersonal-space-and-leadership/ https://acerpacer.com/insights/interpersonal-space-and-leadership/
Redirect 301 /take-care-of-your-lamp/ https://acerpacer.com/insights/take-care-of-your-lamp/
Redirect 301 /voice-of-leadership/ https://acerpacer.com/insights/voice-of-leadership/
Redirect 301 /how-leaders-deal-with-change/ https://acerpacer.com/insights/how-leaders-deal-with-change/
Redirect 301 /my-work/ https://acerpacer.com/my-work/
Redirect 301 /coaching/ https://acerpacer.com/coaching-mentoring-counselling/
Redirect 301 /testimonials/ https://acerpacer.com/testimonials/

# Old WordPress addresses
RedirectMatch 301 ^/feed/?$ /feed.xml
RedirectMatch 301 ^/(index\.php/)?about-this-blog/?$ /about/
RedirectMatch 301 ^/blog/?$ /writing/
RedirectMatch 301 ^/author/adrian/?$ /about/
RedirectMatch 301 ^/contact-me/?$ /about/

# Let browsers keep fonts, images and styles so repeat visits load from the device
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/xml application/rss+xml
</IfModule>
