---
layout: base.njk
---
<article class="wrap prose post">
  <p class="eyebrow"><time datetime="{{ page.date | iso }}">{{ page.date | readable }}</time>{% for t in topics %} · <a href="/topics/{{ t | slug }}/">{{ t }}</a>{% endfor %}</p>
  <h1>{{ title }}</h1>
  {{ content | safe }}
  {% if origin %}<p class="origin">{{ origin }}.</p>{% endif %}
  <p class="back"><a href="/writing/">&larr; All writing</a></p>
</article>
