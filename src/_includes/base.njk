<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != "/" %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preload" href="/assets/fonts/source-serif-4.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/style.css?v={{ site.build }}">
</head>
<body>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">{{ site.name }}</a>
    <nav aria-label="Main">
      {%- for item in site.nav %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>
<main>
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p>{{ site.footer | safe }}</p>
    <p class="small">&copy; {{ site.year }} {{ site.owner }}. All rights reserved.</p>
  </div>
</footer>
</body>
</html>
