---
layout: base.njk
title: Home
---
<section class="wrap intro">
  <p class="eyebrow">Musings by Adrian Chan</p>
  <h1>Adrian Says</h1>
  <div class="about-me">
    {%- if site.portrait %}<img src="{{ site.portrait }}" alt="Adrian Chan" width="96" height="96">{% endif %}
    <p class="lede">{{ site.bio }} <a href="/about/">More about me</a></p>
  </div>
</section>
<section class="wrap">
  {%- if collections.featured.length %}
  <h2>Start here</h2>
  {% set posts = collections.featured %}{% include "postlist.njk" %}
  {%- for e in site.elsewhere %}
  <div class="elsewhere">
    <a href="{{ e.url }}" rel="noopener"><h3>{{ e.title }} <span aria-hidden="true">&nearr;</span></h3></a>
    <p class="meta">{{ e.source }} · {{ e.date }}</p>
    <p>{{ e.note }}</p>
  </div>
  {%- endfor %}
  {%- endif %}
  <h2>Recent writing</h2>
  {% set posts = collections.articles | limit(5) %}{% include "postlist.njk" %}
  <p><a href="/writing/">All writing &rarr;</a></p>
  <h2>Browse by theme</h2>
  <div class="themes">
    {%- for t in collections.topicList %}
    <a class="theme" href="/topics/{{ t.name | slug }}/"><strong>{{ t.name }}</strong><span>{{ t.items.length }} {% if t.items.length == 1 %}piece{% else %}pieces{% endif %}</span></a>
    {%- endfor %}
  </div>
</section>
