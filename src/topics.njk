---
layout: base.njk
pagination:
  data: collections.topicList
  size: 1
  alias: topic
permalink: "/topics/{{ topic.name | slug }}/"
eleventyComputed:
  title: "{{ topic.name }}"
---
<section class="wrap">
  <p class="eyebrow">Theme</p>
  <h1>{{ topic.name }}</h1>
  {% set posts = topic.items %}{% include "postlist.njk" %}
  <p class="back"><a href="/writing/">&larr; All writing</a></p>
</section>
